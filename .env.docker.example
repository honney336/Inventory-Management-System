# Copy to .env and fill in before running docker compose up.
# Generate a secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=change-me-to-a-long-random-string

# Host port to publish the app on
APP_PORT=8000

# Database
# Leave DATABASE_URL unset to use the bundled postgres service.
# For SQLite instead: DATABASE_URL=sqlite:////app/data/inventory.db
DATABASE_URL=
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-too

# Language served when a visitor has not chosen one
DEFAULT_LOCALE=en

# Set true once you are behind HTTPS
SESSION_COOKIE_SECURE=false
SESSION_DAYS=7
ITEMS_PER_PAGE=20
